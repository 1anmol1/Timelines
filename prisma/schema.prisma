generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timelines      Timeline[]
  collaborations TimelineCollaborator[]
  media          Media[]
  reactions      Reaction[]
  comments       Comment[]
  viewerProgress ViewerProgress[]

  @@map("users")
}

// ─── Timelines ──────────────────────────────────────────────────────────────

model Timeline {
  id           String           @id @default(cuid())
  ownerId      String
  title        String
  slug         String
  description  String?
  coverUrl     String?
  visibility   String           @default("PUBLIC") // PUBLIC | PRIVATE | PASSWORD
  status       String           @default("DRAFT")  // DRAFT | PUBLISHED
  passwordHash String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  publishedAt  DateTime?

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nodes          Node[]
  collaborators  TimelineCollaborator[]
  viewerProgress ViewerProgress[]
  analyticsEvents AnalyticsEvent[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([slug])
  @@index([status])
  @@map("timelines")
}

model TimelineCollaborator {
  id         String   @id @default(cuid())
  timelineId String
  userId     String
  role       String   @default("VIEWER") // OWNER | EDITOR | CONTRIBUTOR | VIEWER
  createdAt  DateTime @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([timelineId, userId])
  @@map("timeline_collaborators")
}

// ─── Nodes ──────────────────────────────────────────────────────────────────

model Node {
  id          String   @id @default(cuid())
  timelineId  String
  title       String
  description String?
  position    Int
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  isLocked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timeline    Timeline     @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  blocks      NodeBlock[]
  unlockRules UnlockRule[]
  reactions   Reaction[]
  comments    Comment[]

  // Viewer progress references
  currentViewers ViewerProgress[] @relation("CurrentNode")

  @@index([timelineId])
  @@index([timelineId, position])
  @@map("nodes")
}

model NodeBlock {
  id       String  @id @default(cuid())
  nodeId   String
  type     String  // TEXT | IMAGE | VIDEO | LINK | FILE | EMBED
  position Int
  content  String  @default("{}") // JSON blob
  mediaId  String?

  node  Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([nodeId, position])
  @@map("node_blocks")
}

// ─── Unlock Rules ───────────────────────────────────────────────────────────

model UnlockRule {
  id     String @id @default(cuid())
  nodeId String
  type   String // PREVIOUS_COMPLETED | VIDEO_WATCHED | PASSWORD | DATE | CUSTOM
  config String @default("{}") // JSON blob

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("unlock_rules")
}

// ─── Media ──────────────────────────────────────────────────────────────────

model Media {
  id         String   @id @default(cuid())
  userId     String
  type       String   // IMAGE | VIDEO | FILE | AUDIO
  mimeType   String
  storageKey String
  url        String
  size       Int
  metadata   String   @default("{}") // JSON blob
  createdAt  DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks NodeBlock[]

  @@index([userId])
  @@map("media")
}

// ─── Viewer Progress ────────────────────────────────────────────────────────

model ViewerProgress {
  id                   String   @id @default(cuid())
  timelineId           String
  userId               String?
  sessionId            String
  currentNodeId        String?
  completedNodeIds     String   @default("[]") // JSON array
  completionPercentage Float    @default(0)
  lastViewedAt         DateTime @default(now())

  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentNode Node?    @relation("CurrentNode", fields: [currentNodeId], references: [id], onDelete: SetNull)

  @@unique([timelineId, sessionId])
  @@index([timelineId])
  @@index([sessionId])
  @@map("viewer_progress")
}

// ─── Social ─────────────────────────────────────────────────────────────────

model Reaction {
  id        String   @id @default(cuid())
  nodeId    String
  userId    String?
  sessionId String?
  type      String   // HEART | FIRE | LIGHTBULB | CLAP
  createdAt DateTime @default(now())

  node Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@map("reactions")
}

model Comment {
  id        String   @id @default(cuid())
  nodeId    String
  userId    String?
  sessionId String?
  content   String
  createdAt DateTime @default(now())

  node Node  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@map("comments")
}

// ─── Analytics ──────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  timelineId String
  nodeId     String?
  type       String   // VIEW | NODE_VIEW | NODE_COMPLETE | UNLOCK | SHARE
  sessionId  String
  metadata   String   @default("{}") // JSON blob
  createdAt  DateTime @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([timelineId])
  @@index([type])
  @@index([createdAt])
  @@map("analytics_events")
}
